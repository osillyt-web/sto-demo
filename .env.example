# Скопируйте в .env или задайте в панели хостинга.
# Пароль админки: смените до первого показа клиенту (в админке или здесь).
ADMIN_PASSWORD=change-me-please
# Публичный адрес сайта: нужен для canonical, sitemap и ссылок в напоминаниях.
SITE_URL=https://example.com
# 0.0.0.0 обязателен на хостинге, локально можно не задавать.
HOST=0.0.0.0
PORT=8000
# Защита формы от спама: принятых заявок и любых обращений за 10 минут с одного IP.
LEAD_LIMIT=60
ATTEMPT_LIMIT=200
LEAD_WINDOW_S=600
